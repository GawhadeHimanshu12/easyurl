# Server port
PORT=8080

# Database Configuration (Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://<NEON_HOST>/urlshortener
SPRING_DATASOURCE_USERNAME=your_neon_username
SPRING_DATASOURCE_PASSWORD=your_neon_password

# Redis Configuration (Upstash)
REDIS_URL=rediss://default:your_upstash_password@your_upstash_host:port

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Application Security
JWT_SECRET=super_secret_key_for_jwt_which_must_be_long_enough_to_be_secure

# Base URL (for redirects)
APP_BASE_URL=https://easyurl.tech/

# Admin Users (comma-separated list of emails)
ADMIN_EMAILS=your_email@gmail.com

# Cookie Security (must be true for HTTPS)
SECURE_COOKIE=true
